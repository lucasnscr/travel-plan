# Required
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional - LangSmith tracing
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travel-orchestrator

# Logging
LOG_LEVEL=INFO

# Hotel search providers (Booking.com via RapidAPI)
RAPIDAPI_KEY=
SERPAPI_KEY=

# Google Maps / Places API (activities, directions, geocoding)
GOOGLE_MAPS_API_KEY=

# Enuygun MCP (hotel search upstream)
ENUYGUN_MCP_URL=https://mcp.enuygun.com/mcp
ENUYGUN_OAUTH_CLIENT_ID=
ENUYGUN_OAUTH_CLIENT_SECRET=
ENUYGUN_OAUTH_TOKEN_URL=
ENUYGUN_OAUTH_SCOPE=
